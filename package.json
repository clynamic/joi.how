    "@types/lodash": "^4.17.7",
    "@types/pica": "^9.0.4",
    "@types/spark-md5": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.6",
